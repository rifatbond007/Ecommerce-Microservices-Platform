{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "product_name": "RabbitMQ",
  "product_version": "3.12.0",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "ecommerce.events",
      "vhost": "/",
      "type": "topic",
      "auto_delete": false,
      "durable": true,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "product.events",
      "vhost": "/",
      "type": "topic",
      "auto_delete": false,
      "durable": true,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "order.created",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "order.status_changed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "payment.completed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "payment.failed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notification.email",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "search.product_index",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "order.created",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "order.status_changed",
      "destination_type": "queue",
      "routing_key": "order.status_changed",
      "arguments": {}
    },
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "payment.completed",
      "destination_type": "queue",
      "routing_key": "payment.completed",
      "arguments": {}
    },
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "payment.failed",
      "destination_type": "queue",
      "routing_key": "payment.failed",
      "arguments": {}
    },
    {
      "source": "ecommerce.events",
      "vhost": "/",
      "destination": "notification.email",
      "destination_type": "queue",
      "routing_key": "notification.*",
      "arguments": {}
    },
    {
      "source": "product.events",
      "vhost": "/",
      "destination": "search.product_index",
      "destination_type": "queue",
      "routing_key": "product.*",
      "arguments": {}
    }
  ]
}
