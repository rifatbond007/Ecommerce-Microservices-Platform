# Root .dockerignore — keep services in tree but drop everything else when building
# any service from the repo root.
**/node_modules
**/.git
**/.vscode
**/.idea
**/dist
**/build
**/coverage
**/logs
**/*.log
**/tests
**/jest.config.js
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/Thumbs.db
**/.eslintcache
**/*.tsbuildinfo
**/.cache
**/.npm
**/.nyc_output
PUKU.local.md
docs/
.planning/
