# Service Configuration
PORT=3003
SERVICE_NAME=product-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=product_service

# Redis (cache product detail, category tree)
REDIS_URL=redis://localhost:6379

# RabbitMQ (publisher for product.events)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=product.events

# JWT (only used if product-service verifies tokens locally; mostly trusts gateway headers)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001

# Cache TTLs (seconds)
CACHE_TTL_PRODUCT=300
CACHE_TTL_CATEGORY=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info