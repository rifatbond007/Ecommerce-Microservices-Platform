# Service Configuration
PORT=3008
SERVICE_NAME=search-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=search_service

# Redis (search suggestions cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ (consumes product.*)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=product.events
RABBITMQ_QUEUE=search.product.index
RABBITMQ_ROUTING_KEY=product.*

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3003

# Cache TTLs (seconds)
CACHE_TTL_SUGGESTIONS=120

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info