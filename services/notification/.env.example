# Service Configuration
PORT=3007
SERVICE_NAME=notification-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=notification_service

# Redis (email-queue worker rate-limit)
REDIS_URL=redis://localhost:6379

# RabbitMQ (consumes order.*, payment.*, user.*)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001

# Email (SMTP) — leave empty to skip SMTP and only persist Notification rows
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@ecommerce.local

# Email queue worker
EMAIL_QUEUE_POLL_MS=2000
EMAIL_QUEUE_BATCH=10
EMAIL_MAX_ATTEMPTS=5

# App
APP_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info