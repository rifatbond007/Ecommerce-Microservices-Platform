# Service Configuration
PORT=3009
SERVICE_NAME=admin-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=admin_service

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services (dashboard aggregates from these)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006

# Gateway URL is the canonical entry point for inter-service admin
# calls (Bug 3 fix). See services/admin/src/middleware/internal-call.ts.
GATEWAY_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend URL (used in links from admin emails)
FRONTEND_URL=http://localhost:5173

# Bootstrap admin (matches auth-service ADMIN_EMAIL)
ADMIN_EMAIL=admin@ecommerce.local

# Inter-service HMAC. The gateway signs every request proxied to this
# service so we can verify it really came from the gateway (not an
# attacker forging x-user-id on the internal network). Set the SAME
# value across all 10 services + gateway in production, generated with
# `openssl rand -base64 48`. In production this MUST NOT be the
# placeholder value — services refuse to start.
INTER_SERVICE_SECRET=__SETME_INTER_SERVICE_SECRET_IN_PROD__
INTER_SERVICE_KEY_ID=v1
INTER_SERVICE_CLOCK_SKEW_SECONDS=60