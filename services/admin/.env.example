# Service Configuration
PORT=3009
SERVICE_NAME=admin-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=admin_service

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services (dashboard aggregates from these)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend URL (used in links from admin emails)
FRONTEND_URL=http://localhost:5173

# Bootstrap admin (matches auth-service ADMIN_EMAIL)
ADMIN_EMAIL=admin@ecommerce.local