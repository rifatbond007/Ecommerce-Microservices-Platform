generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  userId          String    @map("user_id")
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("USD")
  status          String    @default("pending")
  paymentMethod   String?   @map("payment_method")
  paymentIntentId String?   @map("payment_intent_id")
  transactionId   String?   @map("transaction_id")
  metadata        Json      @default("{}")
  failureMessage  String?   @map("failure_message")
  paidAt          DateTime? @map("paid_at")
  failedAt        DateTime? @map("failed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refunds Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([paymentIntentId])
  // Admin reconciliation / status dashboards filter by status in date order.
  @@index([status, createdAt(sort: Desc)], map: "idx_payments_status_created_at")
  @@map("payments")
}

model Refund {
  id             String    @id @default(uuid())
  paymentId      String    @map("payment_id")
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("USD")
  reason         String?   @db.Text
  status         String    @default("pending")
  refundId       String?   @map("refund_id")
  failureMessage String?   @map("failure_message")
  refundedAt     DateTime? @map("refunded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}
