# Service Configuration
PORT=3006
SERVICE_NAME=payment-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=payment_service

# Redis (idempotency keys, payment status cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ (publishes payment.completed, payment.failed)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events

# JWT
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Stripe — leave STRIPE_SECRET_KEY empty to use the local mock provider.
# The mock provider issues fake ids and never calls Stripe; it is for dev only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_replace_in_production
STRIPE_PUBLISHABLE_KEY=

# Frontend URL for payment redirects
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Inter-service HMAC. The gateway signs every request proxied to this
# service so we can verify it really came from the gateway (not an
# attacker forging x-user-id on the internal network). Set the SAME
# value across all 10 services + gateway in production, generated with
# `openssl rand -base64 48`. In production this MUST NOT be the
# placeholder value — services refuse to start. NOTE: /api/v1/webhooks/*
# is allow-listed in the verifier middleware because Stripe webhooks
# come in with their own stripe-signature header.
INTER_SERVICE_SECRET=__SETME_INTER_SERVICE_SECRET_IN_PROD__
INTER_SERVICE_KEY_ID=v1
INTER_SERVICE_CLOCK_SKEW_SECONDS=60