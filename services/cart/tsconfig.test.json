{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "paths": {
      "@prisma/cart": [
        "../node_modules/.prisma/cart"
      ]
    }
  },
  "include": [
    "tests/**/*"
  ]
}
