# Service Configuration
PORT=3005
SERVICE_NAME=order-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=order_schema

# Redis (idempotency keys, status cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ (publishes order.created, order.status_changed)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events

# JWT
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001
CART_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Tax (overridable per-region in production)
TAX_RATE=0.10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend URL (for payment redirects)
FRONTEND_URL=http://localhost:5173

# Inter-service HMAC. The gateway signs every request proxied to this
# service so we can verify it really came from the gateway (not an
# attacker forging x-user-id on the internal network). Set the SAME
# value across all 10 services + gateway in production, generated with
# `openssl rand -base64 48`. In production this MUST NOT be the
# placeholder value — services refuse to start.
INTER_SERVICE_SECRET=__SETME_INTER_SERVICE_SECRET_IN_PROD__
INTER_SERVICE_KEY_ID=v1
INTER_SERVICE_CLOCK_SKEW_SECONDS=60