# Service Configuration
PORT=3001
SERVICE_NAME=auth-service
NODE_ENV=development

# Database — single Postgres instance, per-service schema
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=auth

# Redis (sessions, login-attempt counters)
REDIS_URL=redis://localhost:6379

# JWT (HS256). Rotate separately in production.
# In production, these MUST NOT start with `__SETME_` — services fail to
# boot otherwise. Use `openssl rand -base64 48` for each.
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__
JWT_REFRESH_SECRET=__SETME_JWT_REFRESH_SECRET_IN_PROD__
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Bootstrap admin (created on first run if not present)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=Admin123!Change-me

# Inter-service HMAC. Downstream services that call auth directly (currently
# none — user-service reaches auth via Bearer JWT, not HMAC) sign with this.
# Set the SAME value across all 10 services + gateway in production,
# generated with `openssl rand -base64 48`. In production this MUST NOT be
# the placeholder value — services refuse to start.
INTER_SERVICE_SECRET=__SETME_INTER_SERVICE_SECRET_IN_PROD__
INTER_SERVICE_KEY_ID=v1
INTER_SERVICE_CLOCK_SKEW_SECONDS=60