# Service Configuration
PORT=3001
SERVICE_NAME=auth-service
NODE_ENV=development

# Database — single Postgres instance, per-service schema
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=auth

# Redis (sessions, login-attempt counters)
REDIS_URL=redis://localhost:6379

# JWT (HS256). Rotate separately in production.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Bootstrap admin (created on first run if not present)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=Admin123!Change-me