# Service Configuration
PORT=3002
SERVICE_NAME=user-service
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce?schema=user_service

# Redis
REDIS_URL=redis://localhost:6379

# JWT (only required if user-service verifies tokens locally; otherwise trust gateway headers)
JWT_SECRET=__SETME_JWT_SECRET_IN_PROD__

# CORS
CORS_ORIGIN=http://localhost:5173

# Upstream services
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info